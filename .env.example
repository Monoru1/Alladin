# ALLADIN — configuration locale. Copier vers .env (jamais commité).

# DEMO uniquement. Toute autre valeur est refusée au démarrage.
TRADING_MODE=demo

# --- MetaTrader 5 -------------------------------------------------------
# Option A (recommandée) : laisser vide. ALLADIN utilise le compte DEMO déjà
# connecté dans le terminal MT5 ouvert sur cette machine.
# Option B : fournir explicitement les identifiants du compte DEMO.
# Ces valeurs ne sont JAMAIS transmises aux agents (Claude/Codex).
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
# Décalage heure serveur broker -> UTC, en heures (ex: 3). Vide = détection automatique (recommandé).
MT5_SERVER_UTC_OFFSET_HOURS=

# --- Agents (aucune clé API requise) -----------------------------------
# mock | claude | codex   (claude/codex = CLI locaux sous abonnement)
AGENT=mock
AGENT_TIMEOUT_S=180

# --- Stockage ------------------------------------------------------------
ALLADIN_DATA_DIR=data
# DATABASE_URL=sqlite:///data/alladin.db

DEFAULT_PROFILE=ftmo_2step_demo
