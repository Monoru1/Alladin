[Unit]
Description=Alladin — Jafar Mission Control (cockpit lecture seule)
Documentation=https://github.com/Monoru1/Alladin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alladin
Group=alladin
WorkingDirectory=/opt/alladin
EnvironmentFile=/etc/alladin/jafar.env
ExecStart=/opt/alladin/.venv/bin/python -m alladin jafar serve \
    --broker crypto-public \
    --host 127.0.0.1 \
    --port 8002

KillSignal=SIGTERM
TimeoutStopSec=15

# Mission Control peut redémarrer librement — read-only, aucun effet de bord
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alladin-jafar-mc

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alladin /etc/alladin

[Install]
WantedBy=multi-user.target
