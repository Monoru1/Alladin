# =============================================================================
# Alladin Jafar — Environment variables template
# =============================================================================
# Emplacement recommandé sur serveur : /etc/alladin/jafar.env
# Permissions : chmod 600 /etc/alladin/jafar.env
# Owner : root ou utilisateur alladin selon votre politique de sécurité
#
# Copier ce fichier, remplir les valeurs, NE JAMAIS committer les secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Persistence — base de données SQLite
# -----------------------------------------------------------------------------
# Chemin absolu recommandé sur serveur Linux.
# Ne pas utiliser /tmp ou le répertoire de travail courant.
ALLADIN_DATA_DIR=/var/lib/alladin/jafar

# Si vous préférez spécifier l'URL SQLite directement (prioritaire sur DATA_DIR) :
# DATABASE_URL=sqlite:////var/lib/alladin/jafar/alladin.db

# -----------------------------------------------------------------------------
# Binance — données publiques uniquement (crypto-public ne nécessite PAS de clé)
# -----------------------------------------------------------------------------
# Le broker crypto-public utilise l'API publique Binance sans authentification.
# Aucune clé n'est nécessaire pour PAPER / OBSERVE.
#
# Si vous avez besoin d'accès read-only authentifié (rate limits plus hauts) :
# BINANCE_API_KEY=<votre_api_key_read_only>
# JAFAR_BINANCE_PRIVATE_KEY_PATH=/etc/alladin/binance_private.pem

# -----------------------------------------------------------------------------
# Runtime health
# -----------------------------------------------------------------------------
# Délai en secondes au-delà duquel un heartbeat absent marque le runtime STALE
RUNTIME_STALE_AFTER_S=120

# Nombre max de provider failures consécutives avant FAILED (fail-closed)
RUNTIME_MAX_FAILURES=5

# Backoff exponentiel entre les tentatives de recovery (secondes)
RUNTIME_BACKOFF_BASE_S=5
RUNTIME_BACKOFF_CAP_S=60

# -----------------------------------------------------------------------------
# Mission Control
# -----------------------------------------------------------------------------
# Port d'écoute (le service systemd passe --port directement, cette var est
# documentée pour référence mais n'est pas lue automatiquement par le CLI serve)
# PORT=8002

# -----------------------------------------------------------------------------
# Profils et stratégies
# -----------------------------------------------------------------------------
# Laisser vide pour utiliser les chemins par défaut (relatifs au repo cloné)
# DEFAULT_PROFILE=jafar_observe
# REWARD_POLICY_PATH=/opt/alladin/config/reward_policies/outcome_v1.yaml
